<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="en-IN" uiCulture="en-IN" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
  </system.webServer>
	<connectionStrings>
		<!-- Connection String matching exact backend code 'dbcon' -->
		<add name="dbcon" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=SweetDelightsDB;Integrated Security=True" providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
