<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SweetDelights.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SweetDelights Bakery & Desserts</title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- SweetDelights Custom Stylesheet -->
    <link href="~/css/sweetdelights.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Top Announcement Bar -->
        <div class="sd-topbar">
            <div class="container d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-none d-md-flex align-items-center gap-3">
                    <span><i class="bi bi-telephone-fill me-1 text-danger"></i> +1 (800) 555-CAKE</span>
                    <span><i class="bi bi-envelope-fill me-1 text-danger"></i> hello@sweetdelights.com</span>
                </div>
                <div class="text-center flex-grow-1 flex-md-grow-0">
                    <span class="badge bg-white text-danger me-2">Special</span>
                    ✨ Free Express Delivery on orders over <i class="fa-solid fa-indian-rupee-sign"></i>499 | Freshly Baked Every Dawn 🧁
                </div>
                <div class="d-none d-lg-flex align-items-center gap-3">
                    <a href="My_Orders.aspx" class="text-dark"><i class="bi bi-geo-alt-fill me-1 text-danger"></i> Track Order</a>
                    <a href="Admin_Dashboard.aspx" class="badge bg-dark text-white text-decoration-none px-2 py-1"><i class="bi bi-shield-lock me-1"></i> Admin</a>
                </div>
            </div>
        </div>

        <!-- Main Header & Navbar -->
        <header class="sd-navbar">
            <div class="container">
                <nav class="navbar navbar-expand-lg navbar-light p-0">
                    <!-- Brand Logo -->
                    <a class="navbar-brand sd-brand" href="Default.aspx">
                        <i class="fa-solid fa-cake-candles text-danger fs-2"></i>
                        Sweet<span>Delights</span>
                    </a>

                    <!-- Mobile Toggler -->
                    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-1 text-danger"></i>
                    </button>

                    <!-- Navigation Links -->
                    <div class="collapse navbar-collapse" id="navbarContent">
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-link sd-nav-link" href="Default.aspx"><i class="bi bi-house-door me-1"></i> Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sd-nav-link" href="Menu.aspx"><i class="bi bi-cup-hot me-1"></i> Menu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sd-nav-link" href="Show_Products.aspx"><i class="bi bi-grid me-1"></i> Products</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sd-nav-link" href="Show_Company.aspx"><i class="bi bi-shop me-1"></i> Bakeries</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sd-nav-link" href="About.aspx"><i class="bi bi-heart me-1"></i> About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sd-nav-link" href="Contact.aspx"><i class="bi bi-chat-dots me-1"></i> Contact</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sd-nav-link" href="My_Orders.aspx"><i class="bi bi-bag-check me-1"></i> My Orders</a>
                            </li>
                        </ul>

                        <!-- Right Actions: Cart & Login -->
                        <div class="d-flex align-items-center gap-3">
                            <a href="Add_to_Cart.aspx" class="btn btn-outline-danger position-relative rounded-pill px-3 py-2" title="View Cart">
                                <i class="bi bi-cart3 fs-5"></i>
                                <span class="sd-cart-badge"><%= GetCartCount() %></span>
                            </a>
                            <% if (Session["admin"] != null) { %>
                                <div class="dropdown">
                                    <button class="btn btn-sd-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle"></i> <%= Session["admin"].ToString().Contains("@") ? Session["admin"].ToString().Split('@')[0] : Session["admin"].ToString() %>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:12px;">
                                        <li><a class="dropdown-item py-2" href="My_Orders.aspx"><i class="bi bi-bag-check me-2 text-danger"></i>My Orders</a></li>
                                        <li><a class="dropdown-item py-2" href="Add_to_Cart.aspx"><i class="bi bi-cart3 me-2 text-danger"></i>My Cart (<%= GetCartCount() %>)</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item py-2 text-danger" href="Logout.aspx"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                                    </ul>
                                </div>
                            <% } else { %>
                                <a href="Login.aspx" class="btn btn-sd-primary">
                                    <i class="bi bi-person-circle"></i> Login
                                </a>
                            <% } %>
                        </div>
                    </div>
                </nav>
            </div>
        </header>

        <!-- Main Content Placeholder -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Footer -->
        <footer class="sd-footer">
            <div class="container">
                <div class="row g-4">
                    <!-- Brand Bio -->
                    <div class="col-lg-4 col-md-6">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="fa-solid fa-cake-candles text-danger fs-2"></i>
                            <h4 class="text-white mb-0">Sweet<span style="font-family:'Great Vibes'; color:#F8BBD0; font-size:2rem;">Delights</span></h4>
                        </div>
                        <p class="text-light-50 small mb-4" style="color: #C5B6B0;">
                            Crafting sweet moments of joy since 2018. Handcrafted artisan cakes, signature pastries, delicate macarons, and eggless delicacies baked fresh every morning with pure love and premium ingredients.
                        </p>
                        <div class="d-flex gap-2">
                            <a href="#" class="sd-social-btn" title="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="sd-social-btn" title="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="sd-social-btn" title="Pinterest"><i class="bi bi-pinterest"></i></a>
                            <a href="#" class="sd-social-btn" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                        </div>
                    </div>

                    <!-- Quick Links -->
                    <div class="col-lg-2 col-md-6 col-6">
                        <h5>Quick Links</h5>
                        <ul class="list-unstyled">
                            <li><a href="Default.aspx">Home Page</a></li>
                            <li><a href="Menu.aspx">Dessert Menu</a></li>
                            <li><a href="Show_Products.aspx">Browse Cakes</a></li>
                            <li><a href="Show_Company.aspx">Artisan Brands</a></li>
                            <li><a href="About.aspx">Our Story</a></li>
                            <li><a href="Contact.aspx">Contact Us</a></li>
                        </ul>
                    </div>

                    <!-- Categories -->
                    <div class="col-lg-3 col-md-6 col-6">
                        <h5>Bakery Treats</h5>
                        <ul class="list-unstyled">
                            <li><a href="Show_Products.aspx?cat=cakes">Signature Celebration Cakes</a></li>
                            <li><a href="Show_Products.aspx?cat=cupcakes">Handcrafted Cupcakes</a></li>
                            <li><a href="Show_Products.aspx?cat=brownies">Gourmet Chocolate Brownies</a></li>
                            <li><a href="Show_Products.aspx?cat=cheesecake">New York Cheesecakes</a></li>
                            <li><a href="Show_Products.aspx?cat=macarons">French Macarons & Pastries</a></li>
                            <li><a href="Insert.aspx">Custom Cake Orders</a></li>
                        </ul>
                    </div>

                    <!-- Contact & Working Hours -->
                    <div class="col-lg-3 col-md-6">
                        <h5>Visit Our Bakery</h5>
                        <p class="small mb-2" style="color: #C5B6B0;">
                            <i class="bi bi-geo-alt-fill text-danger me-2"></i> 142 Sugarloaf Avenue, Sweet Valley, CA 90210
                        </p>
                        <p class="small mb-2" style="color: #C5B6B0;">
                            <i class="bi bi-clock-fill text-danger me-2"></i> Mon - Sun: 8:00 AM – 10:00 PM
                        </p>
                        <p class="small mb-3" style="color: #C5B6B0;">
                            <i class="bi bi-telephone-fill text-danger me-2"></i> +1 (800) 555-CAKE
                        </p>
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.06); border: 1px dashed rgba(248, 187, 208, 0.3);">
                            <div class="small fw-bold text-white mb-1">🎁 Get 15% Off Your First Order</div>
                            <div class="small" style="color: #F8BBD0;">Use promo code: <strong>SWEET15</strong> at checkout!</div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Copyright -->
                <div class="sd-footer-bottom d-flex flex-wrap justify-content-between align-items-center">
                    <div>
                        © <%= DateTime.Now.Year %> SweetDelights Cakes & Desserts. All rights reserved.
                    </div>
                    <div class="d-flex gap-3">
                        <a href="Default.aspx">Privacy Policy</a>
                        <a href="Default.aspx">Terms of Service</a>
                        <a href="Admin_Dashboard.aspx">Admin Portal</a>
                    </div>
                </div>
            </div>
        </footer>
    </form>

    <!-- Bootstrap 5.3.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetDelights Theme JS -->
    <script src="<%= ResolveUrl("~/js/sweetdelights.js") %>"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
